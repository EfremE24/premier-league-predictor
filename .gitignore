data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts ARE committed (unlike data/): Render's deploy has no
# access to football-data.co.uk-derived CSVs or a place to run the full
# fetch->features->train pipeline at build time, so the API needs these
# files present in the repo to serve predictions at all. Small (~3MB
# total, market_only/team_stat_only are Logistic Regression so tiny;
# combined is the ~3MB Random Forest). Everything else under models/
# stays ignored.
models/*
!models/.gitkeep
!models/model_market_only.joblib
!models/model_team_stat_only.joblib
!models/model_combined.joblib
!models/feature_state.joblib
!models/model_metadata.json

__pycache__/
*.pyc
.pytest_cache/

# Secrets -- API keys live in env vars (Render dashboard in prod, local
# .env for dev), never in committed files.
.env
.env.*
!.env.example

.venv/
venv/
*.egg-info/

.DS_Store
