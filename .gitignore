data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts ARE committed (unlike data/): Render's deploy has no
# access to football-data.co.uk-derived CSVs or a place to run the full
# fetch->features->train pipeline at build time, so the API needs these
# three files present in the repo to serve predictions at all. They're
# small (~3MB total). Everything else under models/ stays ignored.
models/*
!models/.gitkeep
!models/rf_final_model.joblib
!models/feature_state.joblib
!models/model_metadata.json

__pycache__/
*.pyc
.pytest_cache/

# Secrets -- API keys live in env vars (Render dashboard in prod, local
# .env for dev), never in committed files.
.env
.env.*
!.env.example

.venv/
venv/
*.egg-info/

.DS_Store
